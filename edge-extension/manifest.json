{
  "manifest_version": 3,
  "name": "Trust Shield — Edge extension",
  "version": "1.1.0",
  "description": "Edge extension — warns you before you load a dangerous or suspicious URL.",
  "permissions": ["webNavigation", "tabs", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    { "resources": ["warning.html"], "matches": ["<all_urls>"] }
  ],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
