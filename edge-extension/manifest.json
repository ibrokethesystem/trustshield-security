{
  "manifest_version": 3,
  "name": "Trust Shield Extension 2.0",
  "version": "2.0.0",
  "description": "Edge extension — warns you before dangerous URLs and flags fake login pages.",
  "permissions": ["webNavigation", "tabs", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["autofill.js", "fake-login-detector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["warning.html"], "matches": ["<all_urls>"] }
  ],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
